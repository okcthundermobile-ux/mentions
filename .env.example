# Gemini API key (free: https://aistudio.google.com/apikey)
# Powers Fan Pulse sentiment analysis.
GEMINI_API_KEY=

# NewsAPI.org key (free dev key: https://newsapi.org/register)
# Powers the News page and is one article source for Fan Pulse.
NEWS_API_KEY=

# Apify API token (free tier: https://console.apify.com/account/integrations)
# Powers Reddit + Twitter/X gathering for Fan Pulse (via the
# fatihtahta/reddit-scraper-search-fast and apidojo/twitter-scraper-lite
# actors), plus the optional web-scraper article source.
APIFY_API_TOKEN=
# Optional: comma-separated start URLs for the web-scraper article source.
# Defaults to a Google News search for the query if left unset.
# APIFY_TARGET_URLS=https://example.com/thunder,https://another.com/okc

# Google Custom Search (optional extra article source for Fan Pulse)
# Engine: https://programmablesearchengine.google.com  |  Enable "Custom Search API" in Cloud Console
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Local FastAPI stats service (stats_service.py) — roster & player stats.
# Defaults to http://localhost:8000. Run:  uvicorn stats_service:app --port 8000
STATS_SERVICE_URL=http://localhost:8000

# NBA season for stats_service.py (set in its environment, not here):
# NBA_SEASON=2025-26

# Tip: instead of (or in addition to) filling in this file, you can paste
# any of these keys into the running app at /connect. Pasted keys are saved
# only in your browser's localStorage and take priority over these env vars.
