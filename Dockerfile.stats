# Container for the OKC Thunder stats microservice (stats_service.py).
# Deploy separately from the Next.js app — see README.md
# "Hosting the stats service" for the full gcloud command.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY stats_service.py .

# Cloud Run injects $PORT; stats_service.py falls back to 8000 locally.
ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uvicorn stats_service:app --host 0.0.0.0 --port ${PORT}"]
